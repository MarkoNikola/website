Options -Indexes
RewriteEngine On

# ═══════════════════════════════════════════════════════════
#  JEDNA SLUŽBENA ADRESA  →  https://www.italterm.net
#
#  Bez ovoga stranica je dostupna na četiri različite adrese:
#    http://italterm.net        http://www.italterm.net
#    https://italterm.net       https://www.italterm.net
#  Google ih broji kao četiri odvojene stranice i dijeli bodove
#  između njih. Ovo sve preusmjerava na jednu.
#
#  Mora stajati PRIJE pravila za clean URL-ove da se ne bi
#  događala dva preusmjeravanja zaredom (sporije i lošije za SEO).
#
#  VAŽNO: adresa ovdje mora biti ista kao canonical i og:url oznake
#  u HTML datotekama. Ako mijenjate jedno — mijenjajte oboje.
# ═══════════════════════════════════════════════════════════

# 1) bez www → www   (istovremeno prebacuje i na https)
#    Uvjet !^localhost štiti lokalni razvoj (serve-local.js).
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\. [NC]
RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# 2) http → https   (za posjete na www.italterm.net bez https)
#    X-Forwarded-Proto se provjerava jer Hostinger SSL završava na
#    proxyju ispred stranice, pa %{HTTPS} zna pisati "off" i kad je
#    veza sigurna. Bez te linije nastaje beskonačna petlja.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ═══════════════════════════════════════════════════════════
#  STRANICA KOJA NE POSTOJI (404)
#
#  Bez ovoga posjetitelj dobije goli Apache ispis bez izbornika
#  i bez puta natrag. Stare adrese proizvoda (prije spajanja
#  artikala) i dalje kruže Googleom, pa se to stvarno događa.
#
#  404.html koristi apsolutne putanje (/lang.js, /images/…) jer
#  ga Apache poslužuje na adresi koja je pala — relativne bi se
#  računale od te adrese i ne bi se učitale.
# ═══════════════════════════════════════════════════════════
ErrorDocument 404 /404.html

# ═══════════════════════════════════════════════════════════
#  STARE ADRESE SA STAROG (JOOMLA) SAJTA
#
#  Google ih još drži u indeksu i javlja kao "Not found (404)"
#  (vidljivo u Search Consoleu). Umjesto da ih pusti da umru,
#  svaka se preusmjerava na stranicu koja odgovara njezinom
#  sadržaju — tako posjetitelj sa starog linka dođe gdje je
#  krenuo, a Google prenese bodove na novu adresu.
#
#  Dodajete novu? Prekopirajte jedan redak. Putanja se piše BEZ
#  početne kose crte, a bez ?upit (RewriteRule gleda samo putanju).
# ═══════════════════════════════════════════════════════════
RewriteRule ^index\.php/hladenje/klime/?$                          /proizvodi?group=hladenje&cat=klima-uredaji [R=301,L]
RewriteRule ^index\.php/component/content/article/cirk-pumpe/?$    /proizvodi?group=grijanje&cat=cirkulacijske-pumpe [R=301,L]
RewriteRule ^index\.php(/.*)?$                                     / [R=301,L]

# Naslovnica ima jednu adresu: https://www.italterm.net/
# Bez ovoga /index.html i /index poslužuju isti sadržaj kao /,
# pa Google ima tri adrese za istu stranicu.
#
# Uvjet s THE_REQUEST je OBAVEZAN: on gleda izvornu liniju zahtjeva, pa
# pravilo okida samo kad je posjetitelj stvarno tražio /index.html.
# Bez njega bi pravilo uhvatilo i Apacheov interni poziv kojim se za "/"
# poslužuje index.html — i stranica bi ušla u beskonačnu petlju.
RewriteCond %{THE_REQUEST} \s/index(\.html)?[?\s] [NC]
RewriteRule ^index(\.html)?$                                       / [R=301,L]

# ═══════════════════════════════════════════════════════════
#  CLEAN URLs
# ═══════════════════════════════════════════════════════════

# Strip .html from URLs in the browser (canonical clean URLs)
# /proizvod.html?id=foo  →  /proizvod?id=foo
#
# EXCEPTION: search-engine ownership files must stay reachable at their
# exact .html address. Google requests google<code>.html and needs a 200;
# a 301 to /google<code> fails verification. Do not remove these lines
# while the site is verified in Search Console.
#
# POPRAVAK: prije je zadnja skupina hvatala i znak iza ".html" i lijepila
# ga u odredište (`/%1%2`). Kod adrese bez upita taj je znak RAZMAK, pa je
# /index.html preusmjeravao na "/index " — s razmakom na kraju, što je
# mrtva adresa. Sad se hvata samo putanja, a upit (?id=…) prenosi QSA.
RewriteCond %{THE_REQUEST} \s/(.+?)\.html[?\s] [NC]
RewriteCond %{REQUEST_URI} !^/google[0-9a-z]+\.html$ [NC]
RewriteCond %{REQUEST_URI} !^/BingSiteAuth\.xml$ [NC]
RewriteRule ^ /%1 [R=301,L,QSA]

# Internally serve .html files when the extension is absent
# /proizvod?id=foo  →  /proizvod.html?id=foo  (transparent rewrite)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^.]+)$ $1.html [L,QSA]

# ═══════════════════════════════════════════════════════════
#  TEXT COMPRESSION  (gzip)
#  Shrinks HTML/CSS/JS by roughly 70–80% over the wire.
# ═══════════════════════════════════════════════════════════
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject font/ttf font/otf
</IfModule>

# ═══════════════════════════════════════════════════════════
#  BROWSER CACHING
#  Images/fonts rarely change → cache long.
#  HTML must stay fresh so site edits appear immediately.
#  JS/CSS get 1 week; use ?v=2 in the <script> tag to force
#  an early refresh after you change a file.
# ═══════════════════════════════════════════════════════════
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                          "access plus 1 month"

  # Images
  ExpiresByType image/jpeg                "access plus 1 year"
  ExpiresByType image/png                 "access plus 1 year"
  ExpiresByType image/gif                 "access plus 1 year"
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType image/x-icon              "access plus 1 year"

  # Fonts
  ExpiresByType font/ttf                  "access plus 1 year"
  ExpiresByType font/otf                  "access plus 1 year"
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"

  # Scripts & styles
  ExpiresByType text/css                  "access plus 1 week"
  ExpiresByType application/javascript    "access plus 1 week"
  ExpiresByType text/javascript           "access plus 1 week"

  # HTML — always revalidate so content changes go live at once
  ExpiresByType text/html                 "access plus 0 seconds"
</IfModule>

# ═══════════════════════════════════════════════════════════
#  /kontakt?product=… NE IDE U GOOGLE
#
#  Svaki gumb "Zatraži ponudu" vodi na kontakt s upisanom šifrom i
#  nazivom, pa postoji onoliko varijanti te stranice koliko ima
#  artikala. Sve prikazuju isti obrazac. Google ih je počeo indeksirati
#  i javlja kao "Duplicate without user-selected canonical".
#
#  "follow" ostaje: Google smije pratiti linkove s te stranice, samo je
#  ne stavlja u rezultate. Sam /kontakt (bez upita) i dalje se indeksira.
# ═══════════════════════════════════════════════════════════
RewriteCond %{QUERY_STRING} .
RewriteRule ^kontakt(\.html)?$ - [E=NOINDEX:1]

<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, follow" env=NOINDEX

  # Long-lived, immutable static assets
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Scripts & styles — cacheable but revalidated weekly
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>

  # HTML — never served stale
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
